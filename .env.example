# URL base de la API de nico (sin trailing slash)
NICO_API_URL=https://www.nicomanager.com

# Clave API generada en nico → /admin/configuracion/integrations
NICO_API_KEY=nco_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Tilopay (pasarela de pago) ─────────────────────────────────────────────
# Credenciales en app.tilopay.com → Admin → Tilopay Checkout (Integraciones)
TILOPAY_API_URL=https://app.tilopay.com
TILOPAY_API_USER=
TILOPAY_API_PASSWORD=
TILOPAY_API_KEY=
# Moneda ISO del cobro (CRC = colones)
TILOPAY_CURRENCY=CRC

# Secreto compartido con nico para el webhook de cambio de estado del pedido.
# nico lo envía en el header X-Webhook-Secret al avisar ACCEPTED/REJECTED.
NICO_WEBHOOK_SECRET=

# Secreto para firmar los tokens de acceso a los pedidos (tracking). Solo il-capo.
ORDER_TOKEN_SECRET=

# URL pública del sitio (sin trailing slash) para el redirect de retorno de Tilopay.
# En local puede quedar vacío: se usa el origin del request.
NEXT_PUBLIC_APP_URL=
