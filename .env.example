# URL base de la API de nico (sin trailing slash)
NICO_API_URL=https://www.nicomanager.com

# Clave API generada en nico → /admin/configuracion/integrations
NICO_API_KEY=nco_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Tilopay (pasarela de pago) ─────────────────────────────────────────────
# Credenciales en app.tilopay.com → Admin → Tilopay Checkout (Integraciones)
TILOPAY_API_URL=https://app.tilopay.com
TILOPAY_API_USER=
TILOPAY_API_PASSWORD=
TILOPAY_API_KEY=
# Moneda ISO del cobro (CRC = colones)
TILOPAY_CURRENCY=CRC

# Secreto compartido con nico para el webhook de cambio de estado del pedido.
# nico lo envía en el header X-Webhook-Secret al avisar ACCEPTED/REJECTED.
NICO_WEBHOOK_SECRET=

# Secreto para firmar los tokens de acceso a los pedidos (tracking). Solo il-capo.
ORDER_TOKEN_SECRET=

# URL pública del sitio (sin trailing slash) para el redirect de retorno de Tilopay.
# En local puede quedar vacío: se usa el origin del request.
NEXT_PUBLIC_APP_URL=

# ── Cuenta / login ──────────────────────────────────────────────────────────
# Secreto para firmar la cookie de sesión y los desafíos OTP.
# Si queda vacío se usa ORDER_TOKEN_SECRET como fallback.
AUTH_SECRET=

# Login con Google: crear un OAuth Client ID (tipo Web) en
# console.cloud.google.com → APIs & Services → Credentials.
# Redirect URI autorizada: {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
# (en local: http://localhost:3000/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Envío de códigos OTP por correo vía Resend (resend.com, plan gratis).
# Sin esto, en desarrollo el código se muestra en pantalla (modo dev);
# en producción el login por correo no funcionará hasta configurarlo.
RESEND_API_KEY=
EMAIL_FROM="il Capo <pedidos@tudominio.com>"

# Pago en efectivo al recibir. Apagado por defecto: exige verificar el numero
# del cliente por WhatsApp, y eso necesita el numero real del negocio ligado a
# Meta (ver docs/pagos-efectivo.md). Con esto apagado el checkout solo ofrece
# tarjeta, y la API de pedidos rechaza los de efectivo.
NEXT_PUBLIC_CASH_ENABLED=false
